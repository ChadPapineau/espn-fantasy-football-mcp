# ---------------------------------------------------------------------------
# espn-fantasy-football-mcp — hardened .gitignore
# Rule: nothing secret is ever committed. ESPN session cookies (espn_s2, SWID)
# are full account credentials and live OUTSIDE the repo (OS keychain or a
# 0600 file under ~/.config). If a secret ever lands in history, treat it as
# compromised and rotate it — deleting the commit is not enough.
# ---------------------------------------------------------------------------

# --- Dependencies ---------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# --- Build output ---------------------------------------------------------
# ANCHORED to the repo root (S6): an unanchored `lib/` or `build/` silently ignored
# src/lib/*.ts or tests/build/* — a local run stays green while the file is never committed.
/dist/
/build/
/out/
/lib/
*.tsbuildinfo
/coverage/
/.nyc_output/
/.turbo/
/.cache/
.eslintcache
*.tgz

# --- Environment files ----------------------------------------------------
# Every env variant is ignored; only the placeholder example is tracked.
.env
.env.*
*.env
!.env.example

# --- Secrets, tokens, credentials, cookies (belt and braces) --------------
# Scoped to DATA files (S6): a name pattern like `*cookie*` or `secrets.*` used to ignore the
# source files that implement the cookie port (src/auth/cookie.ts, tests/auth/swid.test.ts).
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.token
*.secret
*.secrets
secrets.json
secrets.yaml
secrets.yml
secrets.txt
secrets.ini
credentials.json
credentials.yaml
credentials.yml
credentials.txt
credentials.ini
*credentials*.json
*token*.json
*oauth*.json
*cookie*.json
*cookie*.txt
*cookies*.json
*cookies*.txt
cookies
*.cookie
*.cookies
!*cookie*.example.*
*.har
*session*.json
!*session*.example.json
espn_s2
espn_s2*.txt
espn_s2*.json
swid
swid*.txt
swid*.json
.espn/
.tokens/
/tokens/
/private/

# --- Recorded fixtures before anonymization (never commit raw captures) ---
fixtures/raw/
tests/fixtures/raw/
**/*.raw.json
**/*.recorded.json

# --- Local data caches the server may write ------------------------------
# Archives and databases are never committed (S5: no rule can scan them; scan-secrets refuses them).
/data/cache/
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db3
*.duckdb
*.parquet
*.arrow
*.feather
*.gz
*.zip
*.xz
*.zst
*.bz2
*.7z

# --- Logs -----------------------------------------------------------------
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Test artifacts -------------------------------------------------------
/test-results/
/playwright-report/
junit.xml

# --- Third-party research clones (never committed here) ------------------
/research/vendor/
/vendor/
/scratch/
/tmp/
/temp/

# --- OS -------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editors / IDEs -------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json.example
.idea/
*.iml
*.swp
*.swo
*~
.project
.settings/
.classpath

# --- Claude Code local overrides -----------------------------------------
.claude/settings.local.json
