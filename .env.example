# ---------------------------------------------------------------------------
# espn-fantasy-football-mcp — setting names and example values
#
# EVERY value here is a placeholder. This file is a REFERENCE for the
# setting names: per the plan (docs/plan/03-lifecycle-and-operations.md §3)
# the server does NOT read a `.env` file. Settings are taken, in order, from
#   1. the `env` block of your MCP client's server entry, then
#   2. `<config dir>/config.json` (written by `eff setup`), then
#   3. the defaults shown below.
#
# ESPN session cookies (espn_s2 and SWID) are FULL ACCOUNT CREDENTIALS and
# are NOT settings. They are never read from any env var, `.env`, client
# config, or tool argument. `eff setup` asks for them with hidden input and
# stores them in the OS keychain (or a 0600 file outside the repository).
# Never paste them into chat, logs, issues, or any tracked file.
# ---------------------------------------------------------------------------

# --- League identity (not secret, but personal: never commit a real value) -
# The numeric league id from your ESPN league URL (leagueId=...). Required.
ESPN_LEAGUE_ID=0000000
# The season year to read. Defaults to the current NFL season.
ESPN_SEASON=2026
# Your team id within the league. Normally discovered from the stored SWID.
# ESPN_TEAM_ID=

# --- Where things live (all outside the repository) -----------------------
# Config directory (config.json, the confirmation-gate key, setup results).
EFF_CONFIG_DIR=~/.config/espn-fantasy-football-mcp
# Cache and dataset directory (SQLite store + per-source dataset files).
EFF_CACHE_DIR=~/.cache/espn-fantasy-football-mcp

# --- Credential storage ---------------------------------------------------
# One of: keychain | file. ONE store per install, decided by `eff setup`
# (it tests whether scheduled jobs can read the keychain without a prompt
# and records the result). "file" = a 0600 JSON file in a 0700 directory.
# The choice recorded in config.json wins over any env value (a disagreeing
# one is ignored and `eff doctor` fails on it); use `eff setup --storage`.
# EFF_CREDENTIAL_STORE=keychain
# Used only when EFF_CREDENTIAL_STORE=file. `eff setup` records the path in
# config.json and every process uses that one (a disagreeing env value is
# ignored and `eff doctor` fails on it).
EFF_CREDENTIAL_FILE=~/.config/espn-fantasy-football-mcp/session.json

# --- Server behaviour ----------------------------------------------------
# One of: error | warn | info | debug. Logs go to stderr only (stdout is
# the MCP stdio transport). Cookies, member ids and IPs are redacted.
EFF_LOG_LEVEL=info
# Which tools are registered: core (the P0 set, default) | full (adds P1).
EFF_TOOLSET=core
# How playoff seeding is read: espn_rule (what the league's ESPN settings
# say: record first, points-for as the tiebreak) | points_only (the
# commissioner seeds by total points). Set by `eff setup --seeding`.
EFF_SEEDING_MODE=espn_rule
# Weather source for outdoor games: open-meteo (non-commercial) | nws.
EFF_WEATHER_SOURCE=open-meteo
# Port for the optional one-shot local setup page (`eff setup --page`).
# Unset: tries 8790, then the rest of 8790-8799, and prints the URL it bound.
# Set: that exact port only, no fallback (exit 2 if it is busy).
# EFF_SETUP_PORT=8790

# --- API-drift probe ------------------------------------------------------
# A PUBLIC ESPN league id used by the daily keyless drift probe and for the
# recorded test fixtures. Configure it locally; never commit a real value.
# EFF_PROBE_LEAGUE_ID=0000000
# Emergency override if ESPN moves its API host again. Accepted only when
# it matches ^[a-z0-9-]+\.fantasy\.espn\.com$ so cookies can never be sent
# outside *.fantasy.espn.com. The permanent fix is a release.
# EFF_ESPN_READ_HOST=lm-api-reads.fantasy.espn.com

# --- Write module (NOT built in v1; off by default) -----------------------
# Read-only is the product. If the opt-in write module is ever built, its
# tools register only when this is exactly "true" AND `eff setup
# --enable-writes` has recorded a typed acknowledgement AND a validated
# credential is stored AND your own team resolves from the stored SWID —
# four conditions — and every write still needs an explicit
# human confirmation through a channel the model does not author.
EFF_ENABLE_WRITES=false

# --- Optional third-party data providers (none required) ------------------
# Leave unset to disable. Values are never logged.
# ODDS_API_KEY=
# WEATHER_API_KEY=

# --- Launcher only ---------------------------------------------------------
# Absolute path to the Node binary for the plugin launch script
# (scripts/eff-launch.sh). Unset = resolved automatically.
# EFF_NODE=
