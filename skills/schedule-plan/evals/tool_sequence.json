            "alternatives": [],
            "source_calls": {
              "$source_calls": [
                "roster",
                "playoff_games",
                "proj",
                "replacement",
                "standings",
                "race",
                "plan"
              ]
            },
            "settings_hash": { "$ref": "league.data.scoring.settings_hash" },
            "followed_hint": "unknown",
            "client_ref": "schedule-plan-2026-w5"
          }
        }
      ]
    },
    {
      "id": "both_readings",
      "when": "the seeding reading is unconfirmed and no evidence settles it (seeding-unknown): both readings simulated side by side",
      "fixture_variant": "seeding-unknown",
      "steps": [
        { "id": "status", "tool": "espn_get_status", "args": { "include_checks": true } },
        { "id": "league", "tool": "espn_get_league", "args": {} },
        {
          "id": "seeding",
          "tool": "espn_get_league",
          "args": { "include": ["seeding", "seeding_evidence"] }
        },
        { "id": "roster", "tool": "espn_get_roster", "args": { "week": 5 } },
        {
          "id": "proj",
          "tool": "espn_project_players",
          "args": { "players": { "team_id": 2 }, "horizon": "ros", "seed": 20261006 }
        },
        { "id": "replacement", "tool": "espn_analyze_replacement", "args": { "horizon": "ros" } },
        { "id": "standings", "tool": "espn_get_standings", "args": {} },
        {
          "id": "race",
          "tool": "espn_analyze_matchup",
