# ---------------------------------------------------------------------------
# espn-fantasy-football-mcp — example environment
#
# Copy to `.env` (git-ignored) and fill in real values for the NON-secret
# settings below. EVERY value here is a placeholder.
#
# ESPN session cookies (espn_s2 and SWID) are FULL ACCOUNT CREDENTIALS.
# They are NEVER read from .env and never belong in this directory. The
# server stores them in the OS keychain (macOS default) or in a 0600 file
# outside the repository (see EFF_CREDENTIAL_STORE). Set them with the
# server's setup command, which prompts with hidden input. Never paste them
# into chat, logs, tool output, or any tracked file.
# ---------------------------------------------------------------------------

# --- League identity (not secret, but personal: keep .env untracked) ------
# The numeric league id from the ESPN league URL (leagueId=...).
ESPN_LEAGUE_ID=0000000
# The season year to read. Defaults to the current NFL season when unset.
ESPN_SEASON=2026
# Optional: your team id within the league. Discovered automatically when
# the session cookie identifies you as a league member.
# ESPN_TEAM_ID=

# --- Credential storage (outside the repo) --------------------------------
# One of: keychain | file. "keychain" uses the OS credential store
# (macOS Keychain); "file" uses EFF_CREDENTIAL_FILE created with mode 0600
# inside a 0700 directory. Neither is inside the repository.
EFF_CREDENTIAL_STORE=keychain
# Used only when EFF_CREDENTIAL_STORE=file. Absolute path or ~-prefixed.
EFF_CREDENTIAL_FILE=~/.config/espn-fantasy-football-mcp/session.json

# --- Server behaviour ----------------------------------------------------
# One of: error | warn | info | debug. Logs go to stderr, never stdout
# (stdout is the MCP stdio transport). Credentials are never logged.
EFF_LOG_LEVEL=info
# Local cache for ESPN responses and third-party NFL data (outside the repo).
EFF_CACHE_DIR=~/.cache/espn-fantasy-football-mcp
# Read-only is the default. Write tools (lineup, add/drop, waivers, trades)
# are an opt-in module that is OFF unless this is exactly "true", and every
# write still requires explicit confirmation.
EFF_ENABLE_WRITES=false

# --- Optional third-party data providers (placeholders; none required) ----
# Leave blank to disable a provider. Values are never logged.
# ODDS_API_KEY=
# WEATHER_API_KEY=
