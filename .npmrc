# .npmrc — supply-chain defaults (docs/plan/04 §1, §2; plan 02 §7). Ported from sibling @d72e03b, adapted.
# Third-party code is untrusted: no lifecycle script ever runs on install, every saved version is
# exact, and the engines field is enforced (Node >= 24.15).
save-exact=true
ignore-scripts=true
fund=false
audit=true
engine-strict=true
